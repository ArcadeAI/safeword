{
  "name": "@safeword/retro-relay",
  "version": "0.1.0",
  "description": "Private relay that durably files Safeword retrospective findings to GitHub",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.18.1 || >=26.5.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "build": "tsup",
    "spike": "bun scripts/railway-spike.ts",
    "start": "node dist/main.js",
    "test": "bun run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
