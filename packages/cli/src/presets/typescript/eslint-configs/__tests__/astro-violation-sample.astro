---
// Lint fixture: known violations the preset must catch, one per block it
// assembles. Both are markup-level, so flagging them proves the whole
// eslint-plugin-astro -> astro-eslint-parser -> @astrojs/compiler-rs path ran,
// not just that a rule name is present in the config.
const untrustedHtml = '<b>from a CMS</b>';
---

<!-- safeword's own LLM-critical block -->
<div set:html={untrustedHtml}></div>

<!-- upstream's flat/jsx-a11y-strict block -->
<img src="/logo.svg" />
