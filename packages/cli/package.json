{
  "name": "safeword",
  "version": "0.81.1",
  "description": "CLI for setting up and managing safeword development environments",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcadeAI/safeword.git"
  },
  "homepage": "https://github.com/ArcadeAI/safeword",
  "bugs": "https://github.com/ArcadeAI/safeword/issues",
  "type": "module",
  "bin": {
    "safeword": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/cli-result-v1.json": "./schemas/cli-result-v1.schema.json",
    "./eslint": {
      "types": "./dist/presets/typescript/index.d.ts",
      "import": "./dist/presets/typescript/index.js"
    }
  },
  "files": [
    "codex-plugin",
    "dist",
    "schemas",
    "templates"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node scripts/run-vitest-with-build-lock.mjs",
    "pretest:bdd": "tsup",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js --tags 'not @wip and not @proof.vitest and not @manual and not @live'",
    "test:bdd:live": "NODE_OPTIONS='--import tsx' cucumber-js --tags '@live and not @manual'",
    "test:done": "node scripts/run-vitest-with-build-lock.mjs tests/hooks/ tests/schema.test.ts",
    "test:integration": "node scripts/run-vitest-with-build-lock.mjs tests/integration/",
    "test:smoke:fast": "node scripts/run-vitest-with-build-lock.mjs tests/hooks/ tests/schema.test.ts tests/integration/quality-gates.test.ts tests/integration/jtbd-gate.test.ts tests/smoke/hook-coverage.test.ts",
    "test:smoke": "node scripts/run-vitest-with-build-lock.mjs tests/hooks/ tests/schema.test.ts tests/integration/quality-gates.test.ts tests/integration/jtbd-gate.test.ts tests/smoke/hook-coverage.test.ts tests/integration/phase0-walkthrough.test.ts tests/integration/golden-path.test.ts",
    "test:smoke:live": "node scripts/run-vitest-with-build-lock.mjs --config vitest.live.config.ts",
    "test:smoke:live:github": "node scripts/run-github-live-smokes.mjs",
    "test:release": "node scripts/run-vitest-with-build-lock.mjs --config vitest.release.config.ts",
    "test:slow": "node scripts/run-vitest-with-build-lock.mjs --config vitest.slow.config.ts",
    "test:slow:install-proof": "node scripts/run-vitest-with-build-lock.mjs --config vitest.slow.config.ts tests/integration/non-git-install-proof.slow.test.ts",
    "generate:codex-plugin": "bun scripts/generate-codex-plugin.ts",
    "generate:claude-plugin": "bun scripts/generate-claude-plugin.ts",
    "generate:scenario-rubric": "bun scripts/generate-scenario-rubric.ts",
    "generate:plan-rubric": "bun scripts/generate-plan-rubric.ts",
    "generate:quality-rubric": "bun scripts/generate-quality-rubric.ts",
    "generate:claude-historical-catalogue": "bun scripts/generate-claude-historical-catalogue.ts",
    "check:claude-historical-catalogue": "bun scripts/generate-claude-historical-catalogue.ts --check",
    "check:claude-plugin": "bun scripts/check-claude-plugin-release.ts",
    "check:pr-review-workflows": "bun scripts/check-pr-review-workflows.ts",
    "check:cli-contract": "bun scripts/check-cli-contract.ts",
    "generate:cli-reference": "bun scripts/generate-cli-reference.ts",
    "smoke:pr-review:disposable": "bun scripts/run-pr-review-disposable-smoke.ts",
    "generate:cursor-wrappers": "bun scripts/generate-cursor-wrappers.ts",
    "measure:relay-drain": "bun scripts/measure-relay-drain-throughput.ts",
    "parity:fix": "bun ../../scripts/parity-check.ts --fix",
    "pretest:watch": "tsup",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-vitest-with-build-lock.mjs --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests && bun run lint:gherkin && tsc --noEmit",
    "lint:gherkin": "bun src/cli.ts project lint-gherkin",
    "clean": "rm -rf dist",
    "prepublishOnly": "node scripts/check-bun-publish.js && bun run test:release && bun run build",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint",
    "lint:sh": "if command -v shellcheck >/dev/null 2>&1; then shellcheck **/*.sh; else echo 'shellcheck not installed; skipping'; fi"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.0",
    "@cucumber/messages": "^34.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@secretlint/core": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@tanstack/eslint-plugin-query": "5.102.4",
    "@vitest/eslint-plugin": "1.6.27",
    "commander": "15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "~3.1.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-turbo": "2.10.12",
    "eslint-plugin-unicorn": "72.0.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "typescript-eslint": "8.68.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/bun": "^1.4.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "esbuild": "0.28.2",
    "knip": "6.32.2",
    "prettier": "^3.9.5",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "keywords": [
    "cli",
    "safeword",
    "developer-experience",
    "linting",
    "claude-code"
  ],
  "author": "",
  "license": "MIT"
}
