{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --bun safeword@0.79.6 hook codex session-start --plugin-hook",
            "timeout": 120,
            "statusMessage": "Loading Safeword standing instructions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --bun safeword@0.79.6 hook codex pre-tool-use --plugin-hook",
            "timeout": 30,
            "statusMessage": "Checking Safeword edit gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --bun safeword@0.79.6 hook codex post-tool-use --plugin-hook",
            "timeout": 30,
            "statusMessage": "Surfacing Safeword post-tool context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --bun safeword@0.79.6 hook codex user-prompt-submit --plugin-hook",
            "timeout": 30,
            "statusMessage": "Checking queued Safeword prompt context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --bun safeword@0.79.6 hook codex stop --plugin-hook",
            "timeout": 600,
            "statusMessage": "Checking Safeword stop continuation"
          }
        ]
      }
    ]
  }
}
