+  );
+  expect(started.status, started.stderr).toBe(0);
+  const captured = /^SAFEWORD_AUTHOR_MODEL=(.+)$/mu.exec(readFileSync(envFile, 'utf8'))?.[1];
+  expect(captured).toBe(model);
+  return captured ?? '';
