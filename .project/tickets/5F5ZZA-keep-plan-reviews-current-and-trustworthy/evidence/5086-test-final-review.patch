+        candidate,
+      ),
+    ).toBe('unknown');
+    expect(
+      compareSealedCapabilityResults(
+        { ...manifest, settings: { ...manifest.settings, reasoning: 'high' } },
+        rubrics,
+        author,
+        candidate,
