{
  "schema_version": 1,
  "groups": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-bun-check.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-dependency-readiness.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-safeword-context.ts --agent=claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-version.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-lint-check.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-architecture-heal.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-author-model.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-start-reentry.ts"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/session-compact-context.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/prompt-timestamp.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/prompt-questions.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/runtime/hooks/prompt-retro-nudge.ts"
          }
        ]
      }
    ]
  }
}
