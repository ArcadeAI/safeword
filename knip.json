{
  "ignore": [
    ".safeword/**",
    "plugin/**",
    "packages/cli/templates/**",
    "packages/cli/src/claude-plugin/runtime/dispatch.ts",
    "experiments/**",
    "packages/cli/vitest.live.config.ts",
    "packages/cli/vitest.release.config.ts",
    "packages/cli/vitest.slow.config.ts"
  ],
  "ignoreBinaries": [
    "shfmt",
    "dot",
    "shellcheck",
    "pgrep",
    "rustup",
    "ruff",
    "golangci-lint",
    "mypy",
    "rustfmt",
    "architecture",
    "boundary",
    "setup",
    "check",
    "lint-gherkin",
    "lint-imports",
    "feature-directories",
    "cursor-agent",
    "SessionStart",
    "principles",
    "project",
    "UserPromptSubmit"
  ],
  "ignoreDependencies": [
    "safeword",
    "@next/eslint-plugin-next",
    "@tanstack/eslint-plugin-query",
    "eslint-plugin-better-tailwindcss",
    "eslint-plugin-playwright",
    "eslint-plugin-storybook",
    "eslint-plugin-turbo"
  ],
  "ignoreUnresolved": [
    "\\.safeword/",
    "scripts/check-claude-plugin-release.ts",
    "scripts/parity-check.ts"
  ],
  "ignoreIssues": {
    "packages/cli/src/presets/typescript/index.ts": ["duplicates"]
