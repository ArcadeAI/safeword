{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ESNext.Iterator", "ESNext.Collection"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src/**/*", "vitest.default-projects.ts"],
  "exclude": ["node_modules", "dist", "packages/website"]
}
